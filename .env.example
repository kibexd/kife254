# Email Configuration for Newsletter Subscription
# You need to set these in your production environment (Vercel, Netlify, etc.)

# Your Gmail email address
EMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate this from: https://myaccount.google.com/apppasswords
# Steps:
# 1. Go to Google Account settings
# 2. Security tab
# 3. 2-Step Verification (must be enabled)
# 4. App passwords
# 5. Generate app password for "Mail"
EMAIL_APP_PASSWORD=your-app-password-here

# Example:
# EMAIL_USER=kibeenock7390@gmail.com
# EMAIL_APP_PASSWORD=abcd efgh ijkl mnop
